theme_override_font_sizes/font_size = 18
text = "用自然语言写策略，点击「生成策略」后会生成坦克 AI 脚本，游戏中优先使用。可写关键字：buff / 拾取增益、敌人 / 最近敌人 / 追击 / 拦截、主坦克 / 友军 / 协同作战、基地 / Eagle / 守家 / 不误伤基地 / BrickWallEagle、开火 / 射击 / 清砖 / 见敌开火、移动 / 上下左右 / 寻路 / 前往格子 / 不堵路、最佳射击点 / 站桩开火 / 向上开火、砖墙 / 钢墙 / 水面 / 障碍、随机游荡 / 保持距离 / 不要离基地太远、前半关 / 后半关 / 优先顺序。也可写角色倾向：守家、进攻、清道、支援、拾取优先。注意：不要误伤基地，不要对着 Eagle / BrickWallEagle 开火。示例：优先拾取 buff，其次追击最近敌人，绝不误伤基地；或：待在基地旁边守家，敌人靠近再拦截。"
horizontal_alignment = 1
autowrap_mode = 3

